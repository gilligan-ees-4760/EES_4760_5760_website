    <plot x="287" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Mean age (mo.)" y="282" xMin="0.0" height="191" legend="true" xMax="200.0" yMin="0.0" width="254" xAxis="Tick" display="Ages">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Non-alphas" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
