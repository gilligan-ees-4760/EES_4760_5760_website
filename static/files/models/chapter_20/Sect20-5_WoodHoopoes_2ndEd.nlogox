    <monitor x="15" precision="17" y="216" height="60" fontSize="11" width="100">count turtles</monitor>
    <button x="158" y="99" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="63">go</button>
    <plot x="14" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Number of groups" y="288" xMin="0.0" height="181" legend="false" xMax="10.0" yMin="0.0" width="257" xAxis="Number of birds" display="Group Size Histogram">
