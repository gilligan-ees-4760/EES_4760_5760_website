  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="vary_initialization" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="100">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>extinct?</exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>extinct?</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="num-initial-packs" first="2" step="2" last="10"></steppedValueSet>
        <enumeratedValueSet variable="mean-meeting-rate">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mortality-adult">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mortality-disperser">
          <value value="0.44"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="years-to-simulate">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="carrying-capacity">
          <value value="60"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mean-initial-pack-size" first="2" step="2" last="10"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="vary_meeting_disp_mortality" repetitions="100" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="100">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>extinct?</exitCondition>
      <metrics>
        <metric>ticks</metric>
        <metric>extinct?</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="num-initial-packs">
          <value value="10"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mean-meeting-rate" first="0" step="0.5" last="4"></steppedValueSet>
        <enumeratedValueSet variable="mortality-adult">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mortality-disperser" first="0.2" step="0.05" last="0.6"></steppedValueSet>
        <enumeratedValueSet variable="years-to-simulate">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="carrying-capacity">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mean-initial-pack-size">
          <value value="5"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="vary_initialization_pe" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1">
      <go>get-p-extinct 100</go>
      <metrics>
        <metric>p-extinction</metric>
        <metric>time-to-extinction</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="num-initial-packs" first="2" step="2" last="10"></steppedValueSet>
        <enumeratedValueSet variable="mean-meeting-rate">
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mortality-adult">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mortality-disperser">
          <value value="0.44"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="years-to-simulate">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="carrying-capacity">
          <value value="60"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mean-initial-pack-size" first="2" step="2" last="10"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="vary_meeting_disp_mortality_pe" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1">
      <go>get-p-extinct 100</go>
      <metrics>
        <metric>p-extinction</metric>
        <metric>time-to-extinction</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="num-initial-packs">
          <value value="10"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mean-meeting-rate" first="0" step="0.5" last="4"></steppedValueSet>
        <enumeratedValueSet variable="mortality-adult">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="mortality-disperser" first="0.2" step="0.05" last="0.6"></steppedValueSet>
        <enumeratedValueSet variable="years-to-simulate">
          <value value="100"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="carrying-capacity">
          <value value="60"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mean-initial-pack-size">
