    <view x="5" wrappingAllowedX="false" y="10" frameRate="30.0" minPycor="-16" height="433" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="false" width="433" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <plot x="104" autoPlotX="true" yMax="1.0" autoPlotY="true" yAxis="f(x)" y="1129" xMin="0.0" height="438" legend="false" xMax="1.0" yMin="0.0" width="671" xAxis="x" display="logistic">
