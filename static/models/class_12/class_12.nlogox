    <slider x="5" step="1" y="62" max="381" width="172" display="num-investors" height="50" min="0" direction="Horizontal" default="100.0" variable="num-investors"></slider>
    <slider x="5" step="0.01" y="359" max="1" width="172" display="risk-min" height="50" min="0" direction="Horizontal" default="0.01" variable="risk-min"></slider>
    <slider x="5" step="0.01" y="414" max="1" width="172" display="risk-max" height="50" min="0" direction="Horizontal" default="0.1" variable="risk-max"></slider>
    <button x="140" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="63" display="Step">go</button>
    <chooser x="5" y="603" height="60" variable="turtle-coloring-mode" current="1" width="138" display="turtle-coloring-mode">
      <choice type="string" value="wealth"></choice>
      <choice type="string" value="red"></choice>
    </chooser>
    <button x="5" y="725" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="102" display="Do coloring">color-patches
color-turtles</button>
    <slider x="5" step="0.01" y="292" max="2" width="172" display="risk-multiplier" height="50" min="0" direction="Horizontal" default="2.0" variable="risk-multiplier"></slider>
    <button x="5" y="772" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="107" display="set up turtle 5">ask turtle 5
[
move-to patch 9 9
set shape "default"
set heading 45
fd 1.25
]
</button>
    <slider x="5" step="0.1" y="237" max="2" width="172" display="profit-multiplier" height="50" min="0.1" direction="Horizontal" default="1.0" variable="profit-multiplier"></slider>
    <button x="115" y="772" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="63" display="Donut">ask turtle 5 [ 
  ask (patch-set [neighbors] of [neighbors] of self) with                      
    [not member? self [(patch-set neighbors patch-here)] of myself] 
  [ 
  set pcolor blue
  ]
]</button>
