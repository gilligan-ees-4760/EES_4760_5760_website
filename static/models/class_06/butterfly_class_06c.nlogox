  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="vary-q-all-steps" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>corridor-width</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="q" first="0" step="0.1" last="1"></steppedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
