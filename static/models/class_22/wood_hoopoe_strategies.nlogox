  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="optimize" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>age-diff</metric>
        <metric>foray-timing</metric>
        <metric>group-dist-1</metric>
        <metric>group-dist-2</metric>
        <metric>group-dist-3</metric>
        <metric>performance</metric>
      </metrics>
      <constants>
        <steppedValueSet variable="x2" first="0.01" step="0.01" last="0.5"></steppedValueSet>
        <enumeratedValueSet variable="x1">
          <value value="0"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="p-vacant" first="0.01" step="0.01" last="0.5"></steppedValueSet>
        <enumeratedValueSet variable="strategy">
          <value value="&quot;expected reproduction&quot;"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
