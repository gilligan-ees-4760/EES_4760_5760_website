    <plot x="442" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Number forays" y="53" xMin="1.0" height="175" legend="false" xMax="13.0" yMin="0.0" width="230" xAxis="Month" display="Foray Month Histogram">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
