      </pen>
    </plot>
    <monitor x="14" precision="2" y="421" height="60" fontSize="11" width="186" display="Fraction successful forays">fraction-success</monitor>
    <note x="272" y="431" backgroundDark="0" fontSize="11" width="192" markdown="false" height="39" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Parameters for probabilities in "expected reproduction" strategy</note>
    <slider x="272" step="0.1" y="475" max="5" width="172" display="x1" height="50" min="-5" direction="Horizontal" default="0.0" variable="x1"></slider>
    <slider x="272" step="0.02" y="530" max="2" width="172" display="x2" height="50" min="0" direction="Horizontal" default="0.03" variable="x2"></slider>
    <plot x="679" autoPlotX="true" yMax="10.0" autoPlotY="true" y="235" xMin="1.0" height="175" legend="false" xMax="13.0" yMin="0.0" width="230" display="population">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="679" autoPlotX="true" yMax="10.0" autoPlotY="true" y="53" xMin="0.0" height="175" legend="false" xMax="5.0" yMin="0.0" width="230" display="elders">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>histogram [elders] of turtles</update>
      </pen>
